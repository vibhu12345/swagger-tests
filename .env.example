# Copy to .env.local and fill in your own values. Never commit .env.local.

# Supabase project (Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Together AI key for Mixtral-8x7B-Instruct (https://api.together.xyz)
TOGETHER_API_KEY=your-together-api-key

# HuggingFace access token for all-MiniLM-L6-v2 embeddings (https://huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY=your-huggingface-token

# Demo login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password
